# easylive 生产环境变量（宿主机二进制部署用）。
#
# 用法：复制为服务器上 /opt/easylive/api/.env 后填写；该文件绝不提交进仓库
#   cp deployment-example/api/.env.example /opt/easylive/api/.env
#
# 生成随机密钥：
#   JWT_SECRET:    openssl rand -base64 48
#   TOKEN_API_KEY: openssl rand -hex 24
#
# 注意：POSTGRES_PASSWORD 必须与已有 postgres 数据卷里的一致。
# 如果服务器上还留着旧数据（~/easylive-api_volumes/postgresql_volume/data），
# 密码用旧的；全新部署才用新密码。

# ---------- 应用 ----------
APP_NAME=easylive-api
# 必须与 nginx 配置里反代 api 的端口一致
APP_PORT=3000
APP_ENV=production
LOG_LEVEL=info
# 生产**必须**开启鉴权，否则拿到房间号的人都能入会
AUTH_MODE=required
JWT_SECRET=
TOKEN_TTL=12h
# 非 development 环境下 /token 必须带这个 Key（生产应当改造成你自己的登录鉴权）
TOKEN_API_KEY=
# 会话签名密钥：可留空（留空回落到 JWT_SECRET）；显式配置时至少 16 字符，否则启动拒绝
SESSION_SECRET=

# ---------- 媒体面 ----------
MEDIA_UDP_PORT=7881
ICE_TCP_PORT=7882
# 二进制直接跑在宿主机上，填宿主机能被外网访问的地址：
# easytier 内网地址 + 公网 IPv6（逗号分隔），例如 10.1.0.202,2607:5501:3000:14ad::2
SFU_ADVERTISE_IP=
ICE_INCLUDE_LOOPBACK=false
STUN_URLS=stun:stun.l.google.com:19302

# ---------- TURN 中继 ----------
# 暂不配中继时 TURN_URLS 留空（走 IPv6 直连）；配了错误地址反而拖慢建连
TURN_URLS=
# 与 coturn 的 static-auth-secret 必须完全一致（启用中继时填）
TURN_SECRET=
TURN_REALM=hjy.dmmcloud.com
TURN_EXTERNAL_IP=
# 临时凭证有效期：短一点更安全，但要大于单次会议时长
TURN_CRED_TTL=1h

# ---------- 数据层（Ent + sqlc 混合） ----------
MIGRATIONS_DIR=migrations
# 生产同样建议开启：迁移是幂等的，且由 advisory lock 保证多实例不会并发执行
AUTO_MIGRATE=true
# 采样周期与保留时长：5s 足够画曲线，又不会把库写爆；72h 够跑完一轮对比实验
METRICS_INTERVAL=5s
METRICS_RETENTION=72h

# ---------- PostgreSQL ----------
# 二进制跑在宿主机上，数据库走 127.0.0.1:5432（postgres 跑在 docker 里，只映射回环地址）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=sfu_prod

# ---------- 前端来源（CORS / WS 校验）----------
# 必须是你实际访问的域名，否则浏览器会被 CORS 拦下
WEB_ORIGIN=https://hjy.dmmcloud.com

# ---------- 录制 ----------
# 相对路径，相对于 systemd 的 WorkingDirectory（/opt/easylive/api）
RECORD_DIR=recordings

# ---------- AI（缺失不影响开会，只影响 AI 功能） ----------
# 问答助手需要 DEEPSEEK_API_KEY + PIPER_MODEL_PATH；纪要总结需要 DEEPSEEK_API_KEY + WHISPER_MODEL_PATH。
# 缺了对应项时 AI 会话会明确拒绝并在日志里说明原因，会议本身照常进行。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 转写后端：local（本地 whisper.cpp）或 api（OpenAI Whisper 云端）
STT_BACKEND=local
WHISPER_BIN=/opt/easylive/api/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/easylive/api/models/ggml-small.bin
WHISPER_LANG=zh
# 语音合成后端：piper（本地 Piper CLI）
TTS_BACKEND=piper
PIPER_BIN=/opt/easylive/api/piper/piper
PIPER_MODEL_PATH=/opt/easylive/api/models/zh_CN-huayan-medium.onnx

# ---------- 保护与观测 ----------
WS_MAX_CONNECTIONS=500
ROOM_MAX_PARTICIPANTS=16
HTTP_RATE_LIMIT_PER_IP=100
RESUME_GRACE=30s
# 评测阶段临时打开（/debug/stats 能看每个参与者的 RTP 计数），平时建议关掉
ENABLE_DEBUG_ENDPOINT=false
