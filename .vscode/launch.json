{
    // Go 调试配置（在 devcontainer 内使用；需要 SYS_PTRACE + seccomp:unconfined，已在 .devcontainer/docker-compose.yml 打开）
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "args": [],
            "showLog": true
        },
        {
            "name": "Attach to running (dlv)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/workspaces/${workspaceFolderBasename}"
                }
            ]
        }
    ]
}
