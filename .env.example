# 复制为 .env 后使用：cp .env.example .env
# 该文件同时被 docker compose（变量替换 + env_file）和 Go 应用读取。

# ---------- Docker 卷根目录（与仓库同级的兄弟目录，格式与 egg-api 一致） ----------
DOCKER_VOLUMES_ROOT_DIR=../easylive-api_volumes

# ---------- 应用 ----------
APP_NAME=easylive-api
APP_PORT=8080
APP_BASE_PATH=
APP_ENV=development
LOG_LEVEL=debug

# ---------- 媒体面（WebRTC） ----------
# 单端口 UDP mux：所有 PeerConnection 共用一个 UDP 端口，防火墙/安全组只需开这一个口
MEDIA_UDP_PORT=7881
# 对外广播的候选 IP：留空=自动枚举本机网卡（容器内通常连不通，调试时务必显式设置）
#   浏览器在宿主机  -> 127.0.0.1
#   手机/局域网访问 -> Mac 的局域网 IP，如 192.168.1.23（ipconfig getifaddr en0）
#   云服务器        -> 公网 IP
SFU_ADVERTISE_IP=
# ICE 服务器（本地开发一般只需要 STUN；对称 NAT 场景再加 TURN）
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_REALM=sfu.local
TURN_EXTERNAL_IP=

# ---------- 鉴权（准入与权限模型） ----------
# AUTH_MODE 三态：
#   off      = 不校验（默认）。局域网演示/答辩开箱可用
#   optional = 带令牌就校验并用令牌身份；不带则退化为自报昵称（灰度上线用）
#   required = 必须带有效令牌，否则拒绝入会
AUTH_MODE=off
# 启用鉴权时必须设置：HS256 签名密钥。生产环境请用 32 字节以上的随机串
#   生成：openssl rand -base64 48
JWT_SECRET=
# 令牌有效期（Go duration 格式，如 12h、30m）
TOKEN_TTL=12h
# POST /token 端点在**非 development** 环境必须带 X-API-Key 才允许签发。
# 生产环境应当把这个端点换成你自己的登录鉴权（校验账号密码/SSO 之后签发），
# 这里保留它是为了让本地演示与评测脚本能一键拿到令牌。
TOKEN_API_KEY=

# ---------- 数据层（Ent + sqlc 混合） ----------
# 迁移目录：服务启动时按文件名顺序执行其中的 *.sql（幂等）
MIGRATIONS_DIR=migrations
# 启动时自动执行迁移。默认开启：全新部署若没人手动跑迁移，业务接口会以"表不存在"告终，
# 而媒体功能完全正常——这种组合极易被误判成"接口写错了"
AUTO_MIGRATE=true
# 指标采样周期（写 metric_samples 表；0 表示关闭采样）
METRICS_INTERVAL=5s
# 指标保留时长（定期清理更早的样本；<=0 表示不清理）
# 注意：指标采样与 /healthz 的 cpuSeconds 是 M6 评测的数据来源（见 docs/evaluation.md）
METRICS_RETENTION=72h

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=sfu_dev
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFE_TIME=3600

# ---------- 前端（Vite 开发服务器） ----------
WEB_ORIGIN=http://localhost:5173
WEB_EXTRA_ORIGINS=

# ---------- 信令与保护阈值 ----------
WS_MAX_CONNECTIONS=200
ROOM_MAX_PARTICIPANTS=16
HTTP_RATE_LIMIT_PER_IP=50
WS_HEARTBEAT_INTERVAL=30s
WS_SESSION_TTL=24h

# ---------- Fiber（长连接场景下读写超时保持 0，活性检测交给 WebSocket ping/pong）----------
FIBER_CONCURRENCY=262144
FIBER_READ_TIMEOUT=0
FIBER_WRITE_TIMEOUT=0

# ---------- 调试端点（/debug/stats：连接状态 + 每路 RTP 收发计数）----------
ENABLE_DEBUG_ENDPOINT=true

# ---------- ICE 细节 ----------
ICE_TCP_PORT=7882
ICE_INCLUDE_LOOPBACK=true
