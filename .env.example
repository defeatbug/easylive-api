# 复制为 .env 后使用：cp .env.example .env
# 该文件同时被 docker compose（变量替换 + env_file）和 Go 应用读取。

# ---------- Docker 卷根目录（与仓库同级的兄弟目录，格式与 egg-api 一致） ----------
DOCKER_VOLUMES_ROOT_DIR=../easylive-api_volumes

# ---------- 应用 ----------
APP_NAME=easylive-api
APP_PORT=8080
APP_BASE_PATH=
APP_ENV=development
LOG_LEVEL=debug

# ---------- 媒体面（WebRTC） ----------
# 单端口 UDP mux：所有 PeerConnection 共用一个 UDP 端口，防火墙/安全组只需开这一个口
MEDIA_UDP_PORT=7881
# 对外广播的候选 IP：留空=自动枚举本机网卡（容器内通常连不通，调试时务必显式设置）
#   浏览器在宿主机  -> 127.0.0.1
#   手机/局域网访问 -> Mac 的局域网 IP，如 192.168.1.23（ipconfig getifaddr en0）
#   云服务器        -> 公网 IP
SFU_ADVERTISE_IP=
# ICE 服务器（本地开发一般只需要 STUN；对称 NAT 场景再加 TURN）
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_REALM=sfu.local
TURN_EXTERNAL_IP=

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=sfu_dev
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFE_TIME=3600

# ---------- 前端（Vite 开发服务器） ----------
WEB_ORIGIN=http://localhost:5173
WEB_EXTRA_ORIGINS=

# ---------- 信令与保护阈值 ----------
WS_MAX_CONNECTIONS=200
ROOM_MAX_PARTICIPANTS=16
HTTP_RATE_LIMIT_PER_IP=50
WS_HEARTBEAT_INTERVAL=30s
WS_SESSION_TTL=24h

# ---------- Fiber（长连接场景下读写超时保持 0，活性检测交给 WebSocket ping/pong）----------
FIBER_CONCURRENCY=262144
FIBER_READ_TIMEOUT=0
FIBER_WRITE_TIMEOUT=0

# ---------- 调试端点（/debug/stats：连接状态 + 每路 RTP 收发计数）----------
ENABLE_DEBUG_ENDPOINT=true

# ---------- ICE 细节 ----------
ICE_TCP_PORT=7882
ICE_INCLUDE_LOOPBACK=true
