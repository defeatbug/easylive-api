# 生产环境变量（复制为 deploy/.env.prod 后填写；该文件已被 .gitignore 排除）
#
# 生成随机密钥：
#   JWT_SECRET:    openssl rand -base64 48
#   TURN_SECRET:   openssl rand -base64 48
#   TOKEN_API_KEY: openssl rand -hex 24

# ---------- 应用 ----------
APP_NAME=easylive-api
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=info
# 生产**必须**开启鉴权，否则拿到房间号的人都能入会
AUTH_MODE=required
JWT_SECRET=
TOKEN_TTL=12h
# 非 development 环境下 /token 必须带这个 Key（生产应当改造成你自己的登录鉴权）
TOKEN_API_KEY=

# ---------- 媒体面 ----------
MEDIA_UDP_PORT=7881
ICE_TCP_PORT=7882
# 云服务器的公网 IP（多网卡下自动探测会拿到内网地址，必须显式指定）
SFU_ADVERTISE_IP=
ICE_INCLUDE_LOOPBACK=false
STUN_URLS=stun:stun.l.google.com:19302

# ---------- TURN 中继 ----------
# 部署 coturn 后填公网地址；UDP 与 TCP 都给，客户端 ICE 会自己挑
TURN_URLS=turn:YOUR_PUBLIC_IP:3478?transport=udp,turn:YOUR_PUBLIC_IP:3478?transport=tcp
# 与 coturn 的 static-auth-secret 必须完全一致
TURN_SECRET=
TURN_REALM=sfu.example.com
TURN_EXTERNAL_IP=YOUR_PUBLIC_IP
# 临时凭证有效期：短一点更安全，但要大于单次会议时长
TURN_CRED_TTL=1h

# ---------- PostgreSQL ----------
DOCKER_VOLUMES_ROOT_DIR=../easylive-api_volumes
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=sfu_prod

# ---------- 前端来源（CORS / WS 校验）----------
# 必须是你实际访问的域名，否则浏览器会被 CORS 拦下
WEB_ORIGIN=https://sfu.example.com

# ---------- 保护与观测 ----------
WS_MAX_CONNECTIONS=500
ROOM_MAX_PARTICIPANTS=16
HTTP_RATE_LIMIT_PER_IP=100
RESUME_GRACE=30s
# 评测阶段临时打开（/debug/stats 能看每个参与者的 RTP 计数），平时建议关掉
ENABLE_DEBUG_ENDPOINT=false
