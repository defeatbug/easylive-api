# 生产镜像：多阶段构建。
#
# 为什么用 CGO_ENABLED=0：Pion / pgx 都是纯 Go，静态二进制可以直接跑在极简基础镜像上，
# 没有 glibc 版本耦合，也不会因为宿主机升级而崩。
FROM golang:1.25-alpine AS builder

WORKDIR /src

# 先只拷依赖清单单独一层：只要 go.mod/go.sum 不变，改业务代码不会重新下载依赖
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# -trimpath 去掉本机绝对路径（既减小体积，也避免把开发机的目录结构带进镜像）
# -ldflags "-s -w" 去掉符号表与调试信息
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/easylive-api .

# ---- whisper.cpp 构建（AI 总结本地转写用）----
FROM golang:1.25-alpine AS whisper-builder
RUN apk add --no-cache cmake g++ make git
WORKDIR /src
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp.git . \
    && cmake -B build -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON \
    && cmake --build build -j$(nproc) --target whisper-cli
# 模型在构建时下载（small：中文效果与速度的平衡点；要更快可用 base）
RUN mkdir -p /models && wget -q -O /models/ggml-small.bin \
    https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin

# Piper TTS（AI 问答助手语音合成用）
# 预编译二进制 + 中文语音模型（约 63MB），与 whisper 阶段同模式：
# Go 侧以 CLI 进程调用，保持 CGO_ENABLED=0 构建约束干净。
#
# 注意两点：
# 1. piper 是 glibc 动态链接的二进制（含自带的 libespeak-ng/libonnxruntime 等），
#    整个 piper/ 目录原样拷走（espeak-ng-data 靠相对路径定位，不能只拷二进制）；
# 2. 最终镜像是 Alpine（musl），用 gcompat 提供 glibc 兼容层。
FROM alpine:3.21 AS piper-builder
RUN apk add --no-cache wget tar
RUN mkdir -p /piper /models && wget -q -O /tmp/piper.tar.gz \
    https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz \
    && tar xzf /tmp/piper.tar.gz -C /piper \
    && wget -q -O /models/zh_CN-huayan-medium.onnx \
    https://huggingface.co/rhasspy/piper-voices/resolve/main/zh/zh_CN/huayan/medium/zh_CN-huayan-medium.onnx \
    && wget -q -O /models/zh_CN-huayan-medium.onnx.json \
    https://huggingface.co/rhasspy/piper-voices/resolve/main/zh/zh_CN/huayan/medium/zh_CN-huayan-medium.onnx.json

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata wget libstdc++ \
    && adduser -D -u 10001 -h /app app

WORKDIR /app
COPY --from=builder /out/easylive-api /app/easylive-api
COPY --from=builder /src/migrations /app/migrations
# whisper 本地转写：二进制 + 模型（STT_BACKEND=local 时用；模型约 500MB）
COPY --from=whisper-builder /src/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /models/ggml-small.bin /app/models/ggml-small.bin
ENV STT_BACKEND=local \
    WHISPER_BIN=/usr/local/bin/whisper-cli \
    WHISPER_MODEL_PATH=/app/models/ggml-small.bin
# Piper 本地语音合成：整个 piper/ 目录原样拷走（TTS_BACKEND=piper 时用；AI 问答助手）
# espeak-ng-data 靠相对路径定位，不能只拷二进制；gcompat 给 glibc 二进制提供兼容层（Alpine 是 musl）
COPY --from=piper-builder /piper/piper /opt/piper
COPY --from=piper-builder /models/zh_CN-huayan-medium.onnx* /app/models/
RUN apk add --no-cache gcompat
ENV TTS_BACKEND=piper \
    PIPER_BIN=/opt/piper/piper \
    PIPER_MODEL_PATH=/app/models/zh_CN-huayan-medium.onnx

# 以非 root 运行：容器逃逸的影响面小得多
USER app

# 8080 = 信令/HTTP；7881/udp = 单端口媒体 mux；7882/tcp = ICE-TCP 兜底
EXPOSE 8080 7881/udp 7882/tcp

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/app/easylive-api"]
